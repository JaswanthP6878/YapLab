{
  "name": "yaplab-video",
  "private": true,
  "type": "module",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render YapLabIntro out/yaplab-intro.mp4",
    "render:nocaptions": "remotion render YapLabIntro out/yaplab-intro-nocaptions.mp4 --props='{\"captions\":false}'",
    "still": "remotion still YapLabIntro out/still.png --frame=500",
    "typecheck": "tsc --noEmit",
    "banner": "remotion still Banner ../docs/assets/yaplab-banner.png"
  },
  "dependencies": {
    "@remotion/cli": "4.0.538",
    "@remotion/google-fonts": "4.0.538",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.538"
  },
  "devDependencies": {
    "@types/react": "18.3.12",
    "typescript": "5.6.3"
  }
}
