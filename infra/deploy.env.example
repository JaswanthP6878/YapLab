# Copy to infra/deploy.env (git-ignored) and adjust. No secrets belong here:
# API keys stay in the repo-root .env, which deploy.sh copies to the VM.

# GCP project; defaults to `gcloud config get-value project`.
PROJECT_ID=cascs-528-jaswanth
ZONE=us-east1-b
VM_NAME=yaplab-api
# e2-small is the recommended size; e2-micro is free-tier in us-east1/us-central1/us-west1.
MACHINE_TYPE=e2-small
DISK_SIZE_GB=20
# pd-standard keeps e2-micro inside the free tier; pd-balanced installs faster.
DISK_TYPE=pd-standard

# Backend extras installed on the VM: openai supplies the Nebius SDK client;
# data enables the teaching-moves report. Keep elevenlabs for speech.
# In the VM repo-root .env, set FRONTROW_LLM=nebius and NEBIUS_API_KEY.
# API keys belong only in that ignored .env, not in this deployment example.
UV_EXTRAS="anthropic openai elevenlabs data"

# Public hostname. Leave empty to use the free <static-ip>.sslip.io name, or set
# a domain whose DNS A record points at the VM's static IP (e.g. yaplab.example.com).
PUBLIC_HOST=
