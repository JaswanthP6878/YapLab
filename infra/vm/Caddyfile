# YapLab on one origin. Caddy gets and renews the HTTPS certificate itself
# (Let's Encrypt), serves the frontend, and proxies the API, WebSockets included.
# install-web.sh replaces __HOST__ with the public hostname.
{
	admin off
}

__HOST__ {
	encode zstd gzip

	# The API: health check, REST, audio, and the session WebSocket.
	@api path /health /sessions /sessions/*
	handle @api {
		reverse_proxy 127.0.0.1:8000
	}

	# The frontend build.
	handle {
		root * /var/www/yaplab
		# Vite fingerprints everything under /assets, so it can be cached forever;
		# pages must be revalidated so a deploy takes effect immediately.
		@hashed path /assets/*
		header @hashed Cache-Control "public, max-age=31536000, immutable"
		@page not path /assets/*
		header @page Cache-Control "no-cache"
		# Single-page app: unknown paths fall back to index.html.
		try_files {path} /index.html
		file_server
	}
}
