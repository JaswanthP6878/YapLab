[Unit]
Description=YapLab API (FrontRow backend)
After=network-online.target
Wants=network-online.target

[Service]
User=__USER__
WorkingDirectory=__APP_DIR__/apps/api
# One process only: sessions live in memory. Bound to localhost; Caddy
# proxies /health and /sessions to it. Settings come from __APP_DIR__/.env.
ExecStart=__APP_DIR__/apps/api/.venv/bin/uvicorn frontrow.server:app --host 127.0.0.1 --port 8000
Environment=PYTHONUNBUFFERED=1
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
