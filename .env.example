# FrontRow backend environment

# Which LLM client the backend uses: fake (offline), openai, or anthropic (demo).
FRONTROW_LLM=fake

# OpenAI API key (only needed when FRONTROW_LLM=openai or for live demo runs).
OPENAI_API_KEY=

# Claude key (only needed when FRONTROW_LLM=anthropic).
ANTHROPIC_API_KEY=

# Leave blank to follow the provider: claude-haiku-5-5 for anthropic,
# gpt-4o-mini for openai. A nonempty value overrides that default.
FRONTROW_LLM_MODEL=

# Optional speech engines: none or elevenlabs. Keys stay on the backend.
FRONTROW_TTS=none
FRONTROW_STT=none
FRONTROW_TTS_MODEL=eleven_flash_v2_5
# The browser receives only a short-lived, single-use Scribe token.
ELEVENLABS_API_KEY=

# --- Optional orchestration tunables (defaults shown) ---
# FRONTROW_TICK_INTERVAL_SECONDS=15
# FRONTROW_PER_LISTENER_TIMEOUT_SECONDS=10
# FRONTROW_TRANSCRIPT_WINDOW_SECONDS=30
# FRONTROW_LLM_TIMEOUT_SECONDS=30
# FRONTROW_MODERATOR_GAP_SECONDS=60
# FRONTROW_GROUNDING_MIN_SPAN_CHARS=10

# Comma-separated origins allowed to call the API from a browser (default: *).
# FRONTROW_CORS_ORIGINS=http://localhost:5173
