# FrontRow backend environment

# Which LLM client the backend uses: "fake" (deterministic, offline) or "openai".
FRONTROW_LLM=fake

# OpenAI API key (only needed when FRONTROW_LLM=openai or for live demo runs).
OPENAI_API_KEY=

# Default model for the OpenAI client.
FRONTROW_LLM_MODEL=gpt-4o-mini

# ElevenLabs API key (used later: backend mints short-lived STT tokens for the
# browser; the browser transcribes directly and streams transcript chunks back).
ELEVENLABS_API_KEY=

# --- Optional orchestration tunables (defaults shown) ---
# FRONTROW_TICK_INTERVAL_SECONDS=15
# FRONTROW_PER_LISTENER_TIMEOUT_SECONDS=10
# FRONTROW_TRANSCRIPT_WINDOW_SECONDS=30
# FRONTROW_LLM_TIMEOUT_SECONDS=30
# FRONTROW_MODERATOR_GAP_SECONDS=60
# FRONTROW_GROUNDING_MIN_SPAN_CHARS=10

# Comma-separated origins allowed to call the API from a browser (default: *).
# FRONTROW_CORS_ORIGINS=http://localhost:5173
