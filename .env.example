# YapLab backend environment

# --- NVIDIA Nemotron on Nebius Token Factory (online example) ---
# Set the single active FRONTROW_LLM assignment below to nebius to enable this.
# FRONTROW_LLM=nebius
NEBIUS_API_KEY=
# Blank role overrides use the provider defaults (or a shared model override).
# Fast default: nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
FRONTROW_LLM_MODEL_FAST=
# Reasoning default: nvidia/Nemotron-3-Ultra-550b-a55b
FRONTROW_LLM_MODEL_REASONING=

# Which LLM client the backend uses: "fake" (deterministic, offline),
# "nebius" (Token Factory), "deepseek" (https://api.deepseek.com),
# "anthropic" (Claude), or "openai".
FRONTROW_LLM=fake

# DeepSeek API key (needed when FRONTROW_LLM=deepseek).
DEEPSEEK_API_KEY=

# OpenAI API key (only needed when FRONTROW_LLM=openai).
OPENAI_API_KEY=

# Claude key (only needed when FRONTROW_LLM=anthropic).
ANTHROPIC_API_KEY=

# Leave blank to follow the provider: Nano/Ultra roles for nebius,
# deepseek-flash for deepseek (or set
# deepseek-v4-pro), claude-haiku-5-5 for anthropic, gpt-4o-mini for openai.
# A nonempty shared value sets both roles unless a role-specific override above is set.
FRONTROW_LLM_MODEL=

# Optional speech engines: none or elevenlabs. Keys stay on the backend.
FRONTROW_TTS=none
FRONTROW_STT=none
FRONTROW_TTS_MODEL=eleven_flash_v2_5
# The browser receives only a short-lived, single-use Scribe token.
ELEVENLABS_API_KEY=

# --- Optional orchestration tunables (defaults shown) ---
# FRONTROW_TICK_INTERVAL_SECONDS=15
# FRONTROW_PER_LISTENER_TIMEOUT_SECONDS=10
# FRONTROW_TRANSCRIPT_WINDOW_SECONDS=30
# FRONTROW_LLM_TIMEOUT_SECONDS=30
# FRONTROW_MODERATOR_GAP_SECONDS=60
# Wait for both talk time and accepted transcript words before offering hands.
# FRONTROW_MODERATOR_WARMUP_SECONDS=45
# FRONTROW_MODERATOR_WARMUP_MIN_WORDS=60
# FRONTROW_GROUNDING_MIN_SPAN_CHARS=10

# Comma-separated origins allowed to call the API from a browser (default: *).
# FRONTROW_CORS_ORIGINS=http://localhost:5173

# --- Public demo limits (one uvicorn worker; no login required) ---
# End a room after its last WebSocket has been gone this long (also applies
# to newly created rooms that never connect). Connected silent tabs use max age.
# FRONTROW_IDLE_END_SECONDS=60
# Hard age from creation, including idle time; automatic ending keeps a report.
# FRONTROW_MAX_SESSION_SECONDS=1200
# Retain ended rooms/reports/audio for one hour, then return 404.
# FRONTROW_SESSION_RETENTION_SECONDS=3600
# FRONTROW_MAX_LIVE_SESSIONS=20
# Rolling hour per visitor IP; JSON and PDF creation share the allowance.
# FRONTROW_SESSIONS_PER_IP_PER_HOUR=6
# Issuance attempts, including provider errors; no refund after a provider call.
# FRONTROW_STT_TOKENS_PER_SESSION=10
# Shared admission allowance resets at midnight UTC.
# FRONTROW_MAX_SESSIONS_PER_DAY=150
